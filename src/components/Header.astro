---
import { SITE, url } from '../site';

interface Props {
  wide?: boolean;
}
const { wide = false } = Astro.props;

const links = [
  { href: url('projects/'), label: 'Projects', match: 'projects' },
  { href: url('articles/'), label: 'Articles', match: 'articles' },
  { href: url('guides/'), label: 'C# Guides', short: 'Guides', match: 'guides' },
  { href: url('basketball/'), label: 'Basketball', match: 'basketball' },
];

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class:list={['container', 'bar', { wide }]}>
    <a href={url()} class="brand" aria-label="Home">
      <span class="dot" aria-hidden="true"></span>
      {SITE.name}
    </a>
    <nav aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} aria-current={path.includes(`/${l.match}`) ? 'page' : undefined}>
            {l.short ? (
              <>
                <span class="full">{l.label}</span>
                <span class="short">{l.short}</span>
              </>
            ) : (
              l.label
            )}
          </a>
        ))
      }
      <a class="gh" href={SITE.github} rel="me noopener" target="_blank">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  nav {
    display: flex;
    gap: 1.4rem;
    font-size: 0.95rem;
  }
  nav a {
    color: var(--muted);
    white-space: nowrap;
  }
  .short {
    display: none;
  }
  @media (max-width: 480px) {
    nav {
      gap: 0.75rem;
      font-size: 0.82rem;
    }
    /* GitHub is also in the footer, so drop it on phones to fit the menu */
    .gh,
    .full {
      display: none;
    }
    .short {
      display: inline;
    }
    .brand {
      font-size: 0.95rem;
      gap: 0.45rem;
    }
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    font-weight: 550;
  }
</style>
