---
interface Props {
  text: string;
  compact?: boolean;
}
const { text, compact = false } = Astro.props;
---

<aside class:list={['ai-notice', { compact }]} aria-label="AI use">
  <span class="badge">AI used</span>
  <p>{text}</p>
</aside>

<style>
  .ai-notice {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin: 1.5rem 0 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 8px;
    background: var(--accent-soft);
  }
  .ai-notice p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text);
  }
  .badge {
    flex: none;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--surface);
    margin-top: 0.1rem;
  }
  .compact {
    margin-top: 0.85rem;
    padding: 0.6rem 0.75rem;
    border-left-width: 2px;
  }
  .compact p {
    font-size: 0.82rem;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .ai-notice {
      flex-direction: column;
      gap: 0.4rem;
    }
  }
</style>
