---
import { SITE, url } from '../site';

interface Props {
  wide?: boolean;
}
const { wide = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <div class:list={['container', 'row', { wide }]}>
    <span>© {year} {SITE.name} · Built and written with Claude (AI); each article and project says how AI was used.</span>
    <span class="links">
      <a href={SITE.github} rel="me noopener" target="_blank">GitHub</a>
      {SITE.linkedin && <a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a>}
      {SITE.email && <a href={`mailto:${SITE.email}`}>Email</a>}
      <a href={url('rss.xml')}>RSS</a>
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 1.75rem 0;
    font-size: 0.875rem;
    color: var(--faint);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .links {
    display: flex;
    gap: 1.1rem;
  }
  .links a {
    color: var(--muted);
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
