---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../lib/content';

const articles = await getArticles();
---

<Base wide title="Articles" description="Technical write-ups on the projects, produced with Claude (AI).">
  <p class="eyebrow">Articles</p>
  <h1>Writing</h1>
  <p class="muted lead">Newest first. Technical write-ups and guides; articles marked AI used were produced with Claude, an AI assistant.</p>

  <ul class="card-grid">
    {articles.map((a) => <li><ArticleCard article={a} /></li>)}
  </ul>
</Base>

<style>
  .lead {
    margin: 0 0 2rem;
    font-size: 1.1rem;
  }
</style>
