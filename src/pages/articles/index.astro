---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../lib/content';
import { url } from '../../site';

const articles = (await getArticles()).filter((a) => !a.data.guide);
---

<Base wide title="Articles" description="Technical write-ups on the projects, produced with Claude (AI).">
  <p class="eyebrow">Articles</p>
  <h1>Writing</h1>
  <p class="muted lead">Newest first. Project write-ups and other technical articles; articles marked AI used were produced with Claude, an AI assistant. Looking for how-tos? See the <a href={url('guides/')}>C# guides</a>.</p>

  <ul class="card-grid">
    {articles.map((a) => <li><ArticleCard article={a} /></li>)}
  </ul>
</Base>

<style>
  .lead {
    margin: 0 0 2rem;
    font-size: 1.1rem;
  }
</style>
