---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getArticles } from '../../lib/content';

const articles = await getArticles();
---

<Base title="Articles" description="Technical write-ups on the projects, produced with Claude (AI).">
  <p class="eyebrow">Articles</p>
  <h1>Writing</h1>
  <p class="muted lead">Technical write-ups on the projects and the decisions behind them. Articles marked AI used were produced with Claude, an AI assistant.</p>
  <ArticleList articles={articles} />
</Base>

<style>
  .lead {
    margin: 0 0 1.5rem;
    font-size: 1.1rem;
  }
</style>
