---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../lib/content';

const articles = (await getArticles()).filter((a) =>
  a.data.tags.some((t) => t.toLowerCase() === 'basketball'),
);
---

<Base wide title="Basketball" description="Basketball projects and write-ups, including working with the PlayHQ API.">
  <p class="eyebrow">Basketball</p>
  <h1>Basketball</h1>
  <p class="muted lead">Basketball projects and write-ups, newest first.</p>

  {
    articles.length > 0 ? (
      <ul class="card-grid">
        {articles.map((a) => <li><ArticleCard article={a} /></li>)}
      </ul>
    ) : (
      <p class="muted">Nothing here yet — check back soon.</p>
    )
  }
</Base>

<style>
  .lead {
    margin: 0 0 2rem;
    font-size: 1.1rem;
  }
</style>
