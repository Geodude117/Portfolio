---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Base title="Projects" description=".NET and web projects, each with a technical write-up and a note on how AI was used.">
  <p class="eyebrow">Projects</p>
  <h1>Projects</h1>
  <p class="muted lead">Each project has a technical write-up, and each card says how Claude (AI) was used.</p>

  <div class="stack">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</Base>

<style>
  .lead {
    margin: 0 0 2rem;
    font-size: 1.1rem;
  }
  .stack {
    display: grid;
    gap: 1rem;
  }
</style>
