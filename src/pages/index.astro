---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleList from '../components/ArticleList.astro';
import { getArticles, getProjects } from '../lib/content';
import { SITE, url } from '../site';

const articles = (await getArticles()).slice(0, 4);
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 4);
---

<Base>
  <section class="hero">
    <div class="hero-top">
      <img
        class="avatar"
        src={url('images/geovan.jpg')}
        alt={`Photo of ${SITE.name}`}
        width="480"
        height="480"
        fetchpriority="high"
      />
      <div>
        <p class="eyebrow">{SITE.role}</p>
        <h1>Hi, I'm {SITE.name}.</h1>
      </div>
    </div>
    <p class="intro">{SITE.intro}</p>
    {SITE.about.map((p) => <p class="about">{p}</p>)}
    <div class="cta">
      <a class="btn primary" href={url('projects/')}>See my projects</a>
      <a class="btn" href={url('articles/')}>Read the articles</a>
    </div>
  </section>

  <div class="section-head">
    <h2>Featured projects</h2>
    <a href={url('projects/')}>All projects →</a>
  </div>
  <div class="grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>

  <div class="section-head">
    <h2>Latest articles</h2>
    <a href={url('articles/')}>All articles →</a>
  </div>
  <ArticleList articles={articles} />
</Base>

<style>
  .hero {
    padding: 2.5rem 0 1rem;
  }
  .hero-top {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 0.25rem;
  }
  .hero-top h1 {
    margin-bottom: 0;
  }
  .hero-top + .intro {
    margin-top: 1.25rem;
  }
  .avatar {
    flex: none;
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--surface);
    box-shadow:
      0 0 0 2px var(--accent),
      0 8px 24px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  @media (max-width: 560px) {
    .hero-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .avatar {
      width: 6rem;
      height: 6rem;
    }
  }
  .intro {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 36rem;
    margin: 0;
  }
  .about {
    color: var(--muted);
    max-width: 38rem;
    margin: 1rem 0 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .btn {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 550;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }
  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .btn.primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: #fff;
  }
  @media (prefers-color-scheme: dark) {
    .btn.primary,
    .btn.primary:hover {
      color: #0e131a;
    }
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
  }
</style>
